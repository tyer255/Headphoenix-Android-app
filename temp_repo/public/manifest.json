{
  "name": "Spotify 2.0 - Music & Podcasts",
  "short_name": "Spotify",
  "description": "Stream high-fidelity music, curated playlists, synchronized lyrics, and podcasts anywhere with full offline support.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#121212",
  "theme_color": "#1DB954",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Music",
      "short_name": "Search",
      "description": "Search millions of songs, artists and albums",
      "url": "/?view=search",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Your Library",
      "short_name": "Library",
      "description": "Quick access to your liked tracks & custom playlists",
      "url": "/?view=library",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Liked Songs",
      "short_name": "Liked",
      "description": "Jump straight to your favorite music",
      "url": "/?view=liked",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    }
  ],
  "categories": ["music", "entertainment", "audio"],
  "prefer_related_applications": false
}
